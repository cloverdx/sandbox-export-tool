<Phase number="0">
<Node guiName="create headers" guiX="995" guiY="-75" id="CREATE_HEADERS" type="DATA_GENERATOR">
<attr name="generate"><![CDATA[//#CTL2

// Generates output record.
function integer generate() {
	
	for (integer i = 0; i < length($out.0); i++){
		setStringValue($out.0, i, getFieldName($out.0, i));	
	}
	
	for (integer i = 0; i < length($out.1); i++){
		setStringValue($out.1, i, getFieldName($out.1, i));	
	}

	return ALL;
}

// Called during component initialization.
// function boolean init() {}

