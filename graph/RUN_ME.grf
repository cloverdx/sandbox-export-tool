<GraphParameters>
<GraphParameter defaultHint="sandbox names, comma delimited" name="INCLUDE" public="true" required="true" value="Project1">
<attr name="description"><![CDATA[The list of ONLY the sandboxes you wish to include, separated by commas.
Leave blank to default to all sandboxes and use EXCLUDE to remove specific ones. ]]></attr>
</GraphParameter>
<GraphParameter defaultHint="sandbox names, comma delimited" name="EXCLUDE" public="true" required="true">
<attr name="description"><![CDATA[The list of sandbox names you wish to exclude, comma separated.
If INCLUDE is not blank, this parameter will be ignored.]]></attr>
</GraphParameter>
<GraphParameter name="SANDBOXES_DIR">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	string root = getParamValue("SANDBOX_ROOT");
	integer rootIndex = lastIndexOf(root,"/");
	root = left(root,rootIndex);
	
	
	return root;
}
]]></attr>
</GraphParameter>
<GraphParameter name="ENABLE_INCLUDED">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	if (getParamValue("INCLUDE") == "" or getParamValue("INCLUDE") == null) {return "false";}
	else return "true";
}
]]></attr>
</GraphParameter>
<GraphParameter name="ENABLE_EXCLUDED">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	if (getParamValue("INCLUDE") == "" or getParamValue("INCLUDE") == null) {return "true";}
	else return "false";
}
]]></attr>
</GraphParameter>
<GraphParameter name="TIMESTAMP">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	return date2str(today(),"yyyyMMddhhmmss");
}
]]></attr>
</GraphParameter>
<GraphParameter defaultHint="default true" name="REDACTED_MODE" public="false" required="false">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	if (getParamValue("EXPORT_MODE")=="redacted"){return "true";}
	else {return "false";}
}
]]></attr>
<SingleType name="string"/>
</GraphParameter>
<GraphParameter defaultHint="default true" name="ONLY_CLOVER_FILES" public="false" required="false">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	if (getParamValue("EXPORT_MODE") == "unredacted_clover_files"){return "true";}
	else {return "false";}
}
]]></attr>
<attr name="description"><![CDATA[ONLY FOR UNREDACTED MODE
If "true" only clover files (.grf,.jbf,.etc.) will be exported.
Other files (.csv,.json, etc.) will be ignored.
If "false" all files in sandbox will be exported. ]]></attr>
<SingleType name="string"/>
</GraphParameter>
<GraphParameter defaultHint="default false" name="INCLUDE_LARGE_FILES" public="false" required="false">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	
	if (getParamValue("EXPORT_MODE") == "unredacted_large_files"){return "true";}
	else {return "false";}
}
]]></attr>
<attr name="description"><![CDATA[ONLY FOR UNREDACTED MODE
Large files can take a long time to export
By default files over 100mb will not be exported.
If this parameter is "true" all files will be exported
regardless of size.]]></attr>
<SingleType name="string"/>
</GraphParameter>
<GraphParameter category="advanced" label="Number of executors" name="SANDBOX_EXECUTORS" public="true" required="false" value="10">
<ComponentReference referencedComponent="EXPORT_SANDBOX1" referencedProperty="executorsNumber"/>
</GraphParameter>
<GraphParameter name="UNREDACTED">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	if(getParamValue("REDACTED_MODE") == "true") {return "false";}
	else return "true";
}
]]></attr>
</GraphParameter>
<GraphParameter name="FILE_EXECUTORS" public="true" value="100"/>
<GraphParameter name="FILE_SIZE_LIMIT_MB" value="100"/>
<GraphParameter name="EXPORT_MODE" public="true" required="true" value="redacted">
<SingleType allowCustomValues="false" name="simpleEnum" values="redacted|Redacted Mode;unredacted_clover_files|Unredacted Mode with only Clover files;unredacted_no_large_files|Unredacted Mode with all files under 100MB;unredacted_large_files|Unredacted Mode with all files"/>
</GraphParameter>
<GraphParameterFile fileURL="workspace.prm"/>
</GraphParameters>
<RichTextNote backgroundColor="8080FF" folded="false" fontSize="medium" height="550" id="Note1" textColor="444444" width="451" x="975" y="150">
<attr name="text"><![CDATA[h3. "INCLUDE" and "EXCLUDE" parameters are strings with sandbox names comma separated. SetJobOutput converts them to lists for use in the filters]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="8080FF" folded="false" fontSize="medium" height="376" id="Note5" textColor="444444" width="550" x="2525" y="500">
<attr name="text"><![CDATA[h3. Add timestamp and move to Data Out
Check for Redacted or not


]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="9B59B6" folded="false" fontSize="medium" height="376" id="Note3" textColor="FFFFFF" width="477" x="975" y="-250">
<attr name="text"><![CDATA[h3. Create Sanitization Report with Headers
]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="9B59B6" folded="false" fontSize="medium" height="300" id="Note2" textColor="FFFFFF" width="400" x="1000" y="375">
<attr name="text"><![CDATA[h3. If "INCLUDE" parameter is present, it will take ONLY those sandboxes, ignoring "EXCLUDE". Otherwise it will take all sandboxes EXCEPT what's in "EXCLUDE"]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="9B59B6" enabled="${REDACTED_MODE}" folded="false" fontSize="medium" height="500" id="Note0" textColor="FFFFFF" width="1076" x="1550" y="-450">
<attr name="text"><![CDATA[h3. Write Redaction reports to zip
]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="96C42D" folded="false" fontSize="large" height="576" id="Note4" textColor="000000" width="726" x="225" y="-100">
<attr name="text"><![CDATA[h1. Project Sanitizer
h3. Run this graph to scan your sandboxes and create copies with sensitive data redacted




h3. The output will be a zip file in the data-out folder called "SandboxExport_{TIMESTAMP}.zip"]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="9B59B6" enabled="${REDACTED_MODE}" folded="false" fontSize="medium" height="276" id="Note6" textColor="FFFFFF" width="477" x="1875" y="450">
<attr name="text"><![CDATA[h3. Export in Redacted Mode]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="8080FF" enabled="${UNREDACTED}" folded="false" fontSize="medium" height="276" id="Note7" textColor="444444" width="477" x="1875" y="750">
<attr name="text"><![CDATA[h3. Export unredacted]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="8080FF" enabled="${UNREDACTED}" folded="false" fontSize="medium" height="350" id="Note8" textColor="000000" width="1076" x="1550" y="75">
<attr name="text"><![CDATA[h3. Write unexported files reports to zip
]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="FAF6D6" folded="false" fontSize="medium" height="177" id="Note9" textColor="444444" width="251" x="2350" y="-25">
<attr name="text"><![CDATA[h3. Which reports to write are dynamically enabled/disabled based on REDACTED_MODE parameter]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="FAF6D6" folded="false" fontSize="medium" height="250" id="Note10" textColor="444444" width="377" x="1475" y="500">
<attr name="text"><![CDATA[h3. Which graph to run is dynamically enabled/disabled based on REDACTED_MODE parameter]]></attr>
</RichTextNote>
<Dictionary>
<Entry contentType="string" input="true" name="INCLUDE" output="true" type="list"/>
<Entry contentType="string" input="true" name="EXCLUDE" output="true" type="list"/>
<Entry input="true" name="OUTPUT" output="true" type="string"/>
</Dictionary>
