<attr name="inputMapping"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	$out.1.SANDBOX_PATH = $in.0.URL;
	$out.0.executionLabel = $in.0.name;
	$out.1.ONLY_CLOVER_FILES = getParamValue("ONLY_CLOVER_FILES");
	$out.1.INCLUDE_LARGE_FILES = getParamValue("INCLUDE_LARGE_FILES");
	$out.1.EXECUTORS_NUMBER = getParamValue("FILE_EXECUTORS");
	$out.1.FILE_SIZE_LIMIT_MB = getParamValue("FILE_SIZE_LIMIT_MB");
	return ALL;
}

