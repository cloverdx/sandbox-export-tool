<Record fieldDelimiter="|" name="unexportedFiles" previewAttachment="${DATATMP_DIR}/unexportedFiles.csv" previewAttachmentCharset="UTF-8" quoteChar="both" quotedStrings="false" recordDelimiter="\r\n" skipSourceRows="0" type="delimited">
