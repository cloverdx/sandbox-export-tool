<attr name="partitionSource"><![CDATA[//#CTL2
// Port 0: XML-format files (grf, sgrf, jbf, rjob, prm)
// Port 1: cfg files (Java properties format, no XML quoting)
function integer getOutputPort() {
	string fileURL = lowerCase($in.0.fileURL);
	if (endsWith(fileURL, ".cfg")) { return 1; }
	return 0;
}
]]></attr>
</Node>
