<Node guiName="Sensitive Params List" guiX="595" guiY="600" id="SENSITIVE_PARAMS_LIST" type="DENORMALIZER">
<attr name="denormalize"><![CDATA[//#CTL2
string[] sensitiveParamsList;
function integer append() {
	append(sensitiveParamsList, $in.0.param);
	return OK;
}
function integer transform() {
	$out.0.sensitiveParamsList = sensitiveParamsList;
	return OK;
}
]]></attr>
