string[] propertiesList;
function integer append() {
	if (!startsWith($in.0.property, "##")) { append(propertiesList, $in.0.property); }
	return OK;
}
function integer transform() {
	$out.0.propertiesList = propertiesList;
	return OK;
}
]]></attr>
