<Node guiName="Redact CFG URL Properties" guiX="1195" guiY="350" id="REDACT_CFG" type="REFORMAT">
<attr name="transform"><![CDATA[//#CTL2

// ============================================================
// URL redaction for .cfg files (Java properties format)
// Matches:  propertyName=value  (no XML quotes)
// Value runs to end of line. Same smart redaction logic.
// Both property list and sensitive query param list are CSV-driven.
// ============================================================

function string redactQueryParams(string urlVal, string[] sensitiveParams) {
	integer qPos = indexOf(urlVal, "?");
	if (qPos < 0) { return urlVal; }
	string base        = left(urlVal, qPos + 1);
	string queryString = right(urlVal, length(urlVal) - qPos - 1);
	// Normalise XML-encoded ampersands so &amp;param=val is treated as a separate param
	boolean xmlEncoded = contains(queryString, "&amp;");
	if (xmlEncoded) { queryString = replace(queryString, "&amp;", "&"); }
	string[] params    = split(queryString, "&");
	boolean changed    = false;
	for (integer i = 0; i < length(params); i++) {
		string param  = params[i];
		integer eqPos = indexOf(param, "=");
		if (eqPos < 0) { continue; }
		string paramName  = lowerCase(left(param, eqPos));
		string paramValue = right(param, length(param) - eqPos - 1);
		if (startsWith(paramValue, "${")) { continue; }
		if (paramValue == "" or paramValue == "REDACTED") { continue; }
		if (in(paramName, sensitiveParams)) {
			params[i] = concat(left(param, eqPos + 1), "REDACTED");
			changed = true;
			dictionary.status = "REDACTED";
		}
	}
	if (!changed) { return urlVal; }
	// Reconstruct with the same delimiter that was in the original URL
	string joinSep;
	if (xmlEncoded) { joinSep = "&amp;"; } else { joinSep = "&"; }
	return concat(base, join(joinSep, params));
}

function string redactAuthority(string urlVal, integer schemeEnd) {
	integer atPos = indexOf(urlVal, "@");
	if (atPos <= schemeEnd) { return urlVal; }
	integer slashPos = indexOf(urlVal, "/", schemeEnd);
	if (slashPos >= 0 and atPos > slashPos) { return urlVal; }
	string authority = substring(urlVal, schemeEnd, atPos - schemeEnd);
	if (contains(authority, "${")) { return urlVal; }
	dictionary.status = "REDACTED";
	return concat(left(urlVal, schemeEnd), "REDACTED@", right(urlVal, length(urlVal) - atPos - 1));
}

function string extractInnerURL(string urlVal) {
	integer parenOpen  = indexOf(urlVal, "(");
	integer parenClose = lastIndexOf(urlVal, ")");
	if (parenOpen < 0 or parenClose <= parenOpen) { return ""; }
	return substring(urlVal, parenOpen + 1, parenClose - parenOpen - 1);
}

function string rebuildWrapper(string urlVal, string redactedInner) {
	integer parenOpen  = indexOf(urlVal, "(");
	integer parenClose = lastIndexOf(urlVal, ")");
	return concat(left(urlVal, parenOpen + 1), redactedInner, right(urlVal, length(urlVal) - parenClose));
}

function string redactURLValue(string urlVal, string[] sensitiveParams) {
	if (isnull(urlVal) or urlVal == "") { return urlVal; }
	if (startsWith(urlVal, "${")) { return urlVal; }
	string lc = lowerCase(urlVal);
	if (startsWith(lc, "sandbox://")) { return urlVal; }
	if (startsWith(lc, "dict:"))      { return urlVal; }
	if (startsWith(lc, "port:"))      { return urlVal; }
	if (startsWith(lc, "clover://"))  { return urlVal; }
	if (startsWith(lc, "file:/"))     { return urlVal; }
	if (startsWith(lc, "hdfs://"))    { return urlVal; }
	if (contains(lc, ":(proxy://")) {
		integer proxyOpen  = indexOf(urlVal, "(");
		integer proxyClose = indexOf(urlVal, ")");
		if (proxyOpen > 0 and proxyClose > proxyOpen) {
			string proxyURL  = substring(urlVal, proxyOpen + 1, proxyClose - proxyOpen - 1);
			string actualURL = right(urlVal, length(urlVal) - proxyClose - 1);
			if (startsWith(actualURL, "//")) { actualURL = right(actualURL, length(actualURL) - 2); }
			string redProxy  = proxyURL;
			if (startsWith(lowerCase(proxyURL), "proxy://")) { redProxy = redactAuthority(proxyURL, 8); }
			string redActual = actualURL;
			integer schEnd   = indexOf(actualURL, "://") + 3;
			// If the actual URL has no scheme (consumed by the outer wrapper), use offset 0
			// so redactAuthority and redactQueryParams still run against the schemeless URL
			if (schEnd <= 2) { schEnd = 0; }
			redActual = redactAuthority(actualURL, schEnd);
			redActual = redactQueryParams(redActual, sensitiveParams);
			if (redProxy != proxyURL or redActual != actualURL) {
				return concat(left(urlVal, proxyOpen + 1), redProxy, ")//", redActual);
			}
		}
		return urlVal;
	}
	if (startsWith(lc, "zip:(")) {
		string inner = extractInnerURL(urlVal);
		if (inner != "") {
			string innerLc  = lowerCase(inner);
			string redInner = inner;
			integer schEnd  = indexOf(inner, "://") + 3;
			if (schEnd > 2 and !startsWith(innerLc, "file:/") and !startsWith(innerLc, "sandbox://")) {
				redInner = redactAuthority(inner, schEnd);
				redInner = redactQueryParams(redInner, sensitiveParams);
			}
			if (startsWith(innerLc, "zip:(")) {
				string inner2 = extractInnerURL(inner);
				if (inner2 != "") {
					integer schEnd2  = indexOf(inner2, "://") + 3;
					string redInner2 = inner2;
					if (schEnd2 > 2 and !startsWith(lowerCase(inner2), "file:/")) {
						redInner2 = redactAuthority(inner2, schEnd2);
						redInner2 = redactQueryParams(redInner2, sensitiveParams);
					}
					if (redInner2 != inner2) { redInner = rebuildWrapper(inner, redInner2); }
				}
			}
			if (redInner != inner) { return rebuildWrapper(urlVal, redInner); }
		}
		return urlVal;
	}
	if (startsWith(lc, "gzip:(")) {
		string inner = extractInnerURL(urlVal);
		if (inner != "") {
			string innerLc  = lowerCase(inner);
			integer schEnd  = indexOf(inner, "://") + 3;
			string redInner = inner;
			if (schEnd > 2 and !startsWith(innerLc, "file:/") and !startsWith(innerLc, "sandbox://")) {
				redInner = redactAuthority(inner, schEnd);
				redInner = redactQueryParams(redInner, sensitiveParams);
			}
			if (redInner != inner) { return rebuildWrapper(urlVal, redInner); }
		}
		return urlVal;
	}
	integer schemeEnd = indexOf(urlVal, "://") + 3;
	if (startsWith(lc, "ftp://") or startsWith(lc, "ftps://") or startsWith(lc, "sftp://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "http://") or startsWith(lc, "https://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "s3://") or startsWith(lc, "s3a://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "az-blob://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "smb://") or startsWith(lc, "smb2://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		return urlVal;
	}
	if (startsWith(lc, "ldap://") or startsWith(lc, "ldaps://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (contains(urlVal, "://") and contains(urlVal, "@")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
	}
	return urlVal;
}

function integer transform() {
	string lineContent         = nvl($in.0.lineContent, "");
	string originalLineContent = lineContent;
	string[] sensitiveParams   = $in.0.sensitiveParamsList;
	// Skip comment lines and blank lines
	if (startsWith(trim(lineContent), "#") or trim(lineContent) == "") {
		$out.0.lineContent = lineContent;
		$out.0.fileURL     = $in.0.fileURL;
		$out.1.status      = dictionary.status;
		$out.1.sandbox     = getParamValue("SANDBOX_NAME");
		$out.1.file_url    = $in.0.fileURL;
		$out.1.file_name   = getParamValue("FILE_NAME");
		return ALL;
	}
	string[] editedProperties;
	foreach (string property : $in.0.propertiesList) {
		// .cfg format: property=value  (value runs to end of line, no quotes)
		string prefix = concat(property, "=");
		if (startsWith(lineContent, prefix) and !startsWith(lineContent, concat(property, "=${"))) {
			// Extract the value — everything after "property="
			string rawValue = right(lineContent, length(lineContent) - length(prefix));
			string redacted = redactURLValue(rawValue, sensitiveParams);
			if (redacted != rawValue) {
				lineContent = concat(prefix, redacted);
				if (!in(property, editedProperties)) { append(editedProperties, property); }
			}
		}
	}
	$out.0.lineContent = lineContent;
	$out.0.fileURL     = $in.0.fileURL;
	if (lineContent != originalLineContent) { dictionary.status = "REDACTED"; }
	$out.1.status    = dictionary.status;
	$out.1.sandbox   = getParamValue("SANDBOX_NAME");
	$out.1.file_url  = $in.0.fileURL;
	$out.1.file_name = getParamValue("FILE_NAME");
	if (length(editedProperties) > 0) {
		$out.1.type = "connection";
		$out.1.redacted_properties = join(",", editedProperties);
	}
	if ($out.1.status == "REDACTED") { $out.1.message = "Potentially sensitive data in URL"; }
	return ALL;
}
]]></attr>
</Node>
<Node guiName="Redact XML URL Properties" guiX="1195" guiY="200" id="REDACT_XML" type="REFORMAT">
<attr name="transform"><![CDATA[//#CTL2

// ============================================================
// URL redaction for XML-format files (.grf, .sgrf, .jbf, .rjob, .prm)
// Matches:  propertyName="value"
// Both property list and sensitive query param list are CSV-driven.
// ============================================================

function string redactQueryParams(string urlVal, string[] sensitiveParams) {
	integer qPos = indexOf(urlVal, "?");
	if (qPos < 0) { return urlVal; }
	string base        = left(urlVal, qPos + 1);
	string queryString = right(urlVal, length(urlVal) - qPos - 1);
	// Normalise XML-encoded ampersands so &amp;param=val is treated as a separate param
	boolean xmlEncoded = contains(queryString, "&amp;");
	if (xmlEncoded) { queryString = replace(queryString, "&amp;", "&"); }
	string[] params    = split(queryString, "&");
	boolean changed    = false;
	for (integer i = 0; i < length(params); i++) {
		string param  = params[i];
		integer eqPos = indexOf(param, "=");
		if (eqPos < 0) { continue; }
		string paramName  = lowerCase(left(param, eqPos));
		string paramValue = right(param, length(param) - eqPos - 1);
		if (startsWith(paramValue, "${")) { continue; }
		if (paramValue == "" or paramValue == "REDACTED") { continue; }
		if (in(paramName, sensitiveParams)) {
			params[i] = concat(left(param, eqPos + 1), "REDACTED");
			changed = true;
			dictionary.status = "REDACTED";
		}
	}
	if (!changed) { return urlVal; }
	// Reconstruct with the same delimiter that was in the original URL
	string joinSep;
	if (xmlEncoded) { joinSep = "&amp;"; } else { joinSep = "&"; }
	return concat(base, join(joinSep, params));
}

function string redactAuthority(string urlVal, integer schemeEnd) {
	integer atPos = indexOf(urlVal, "@");
	if (atPos <= schemeEnd) { return urlVal; }
	integer slashPos = indexOf(urlVal, "/", schemeEnd);
	if (slashPos >= 0 and atPos > slashPos) { return urlVal; }
	string authority = substring(urlVal, schemeEnd, atPos - schemeEnd);
	if (contains(authority, "${")) { return urlVal; }
	dictionary.status = "REDACTED";
	return concat(left(urlVal, schemeEnd), "REDACTED@", right(urlVal, length(urlVal) - atPos - 1));
}

function string extractInnerURL(string urlVal) {
	integer parenOpen  = indexOf(urlVal, "(");
	integer parenClose = lastIndexOf(urlVal, ")");
	if (parenOpen < 0 or parenClose <= parenOpen) { return ""; }
	return substring(urlVal, parenOpen + 1, parenClose - parenOpen - 1);
}

function string rebuildWrapper(string urlVal, string redactedInner) {
	integer parenOpen  = indexOf(urlVal, "(");
	integer parenClose = lastIndexOf(urlVal, ")");
	return concat(left(urlVal, parenOpen + 1), redactedInner, right(urlVal, length(urlVal) - parenClose));
}

function string redactURLValue(string urlVal, string[] sensitiveParams) {
	if (isnull(urlVal) or urlVal == "") { return urlVal; }
	if (startsWith(urlVal, "${")) { return urlVal; }
	string lc = lowerCase(urlVal);
	if (startsWith(lc, "sandbox://")) { return urlVal; }
	if (startsWith(lc, "dict:"))      { return urlVal; }
	if (startsWith(lc, "port:"))      { return urlVal; }
	if (startsWith(lc, "clover://"))  { return urlVal; }
	if (startsWith(lc, "file:/"))     { return urlVal; }
	if (startsWith(lc, "hdfs://"))    { return urlVal; }
	if (contains(lc, ":(proxy://")) {
		integer proxyOpen  = indexOf(urlVal, "(");
		integer proxyClose = indexOf(urlVal, ")");
		if (proxyOpen > 0 and proxyClose > proxyOpen) {
			string proxyURL  = substring(urlVal, proxyOpen + 1, proxyClose - proxyOpen - 1);
			string actualURL = right(urlVal, length(urlVal) - proxyClose - 1);
			if (startsWith(actualURL, "//")) { actualURL = right(actualURL, length(actualURL) - 2); }
			string redProxy  = proxyURL;
			if (startsWith(lowerCase(proxyURL), "proxy://")) { redProxy = redactAuthority(proxyURL, 8); }
			string redActual = actualURL;
			integer schEnd   = indexOf(actualURL, "://") + 3;
			// If the actual URL has no scheme (consumed by the outer wrapper), use offset 0
			// so redactAuthority and redactQueryParams still run against the schemeless URL
			if (schEnd <= 2) { schEnd = 0; }
			redActual = redactAuthority(actualURL, schEnd);
			redActual = redactQueryParams(redActual, sensitiveParams);
			if (redProxy != proxyURL or redActual != actualURL) {
				return concat(left(urlVal, proxyOpen + 1), redProxy, ")//", redActual);
			}
		}
		return urlVal;
	}
	if (startsWith(lc, "zip:(")) {
		string inner = extractInnerURL(urlVal);
		if (inner != "") {
			string innerLc  = lowerCase(inner);
			string redInner = inner;
			integer schEnd  = indexOf(inner, "://") + 3;
			if (schEnd > 2 and !startsWith(innerLc, "file:/") and !startsWith(innerLc, "sandbox://")) {
				redInner = redactAuthority(inner, schEnd);
				redInner = redactQueryParams(redInner, sensitiveParams);
			}
			if (startsWith(innerLc, "zip:(")) {
				string inner2 = extractInnerURL(inner);
				if (inner2 != "") {
					integer schEnd2  = indexOf(inner2, "://") + 3;
					string redInner2 = inner2;
					if (schEnd2 > 2 and !startsWith(lowerCase(inner2), "file:/")) {
						redInner2 = redactAuthority(inner2, schEnd2);
						redInner2 = redactQueryParams(redInner2, sensitiveParams);
					}
					if (redInner2 != inner2) { redInner = rebuildWrapper(inner, redInner2); }
				}
			}
			if (redInner != inner) { return rebuildWrapper(urlVal, redInner); }
		}
		return urlVal;
	}
	if (startsWith(lc, "gzip:(")) {
		string inner = extractInnerURL(urlVal);
		if (inner != "") {
			string innerLc  = lowerCase(inner);
			integer schEnd  = indexOf(inner, "://") + 3;
			string redInner = inner;
			if (schEnd > 2 and !startsWith(innerLc, "file:/") and !startsWith(innerLc, "sandbox://")) {
				redInner = redactAuthority(inner, schEnd);
				redInner = redactQueryParams(redInner, sensitiveParams);
			}
			if (redInner != inner) { return rebuildWrapper(urlVal, redInner); }
		}
		return urlVal;
	}
	integer schemeEnd = indexOf(urlVal, "://") + 3;
	if (startsWith(lc, "ftp://") or startsWith(lc, "ftps://") or startsWith(lc, "sftp://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "http://") or startsWith(lc, "https://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "s3://") or startsWith(lc, "s3a://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "az-blob://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (startsWith(lc, "smb://") or startsWith(lc, "smb2://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		return urlVal;
	}
	if (startsWith(lc, "ldap://") or startsWith(lc, "ldaps://")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
		urlVal = redactQueryParams(urlVal, sensitiveParams);
		return urlVal;
	}
	if (contains(urlVal, "://") and contains(urlVal, "@")) {
		urlVal = redactAuthority(urlVal, schemeEnd);
	}
	return urlVal;
}

string component;
string connection;
boolean isConnection = false;
boolean isComponent  = false;

function integer transform() {
	string lineContent         = nvl($in.0.lineContent, "");
	string originalLineContent = lineContent;
	string[] sensitiveParams   = $in.0.sensitiveParamsList;
	if (startsWith(lineContent, "<Connection")) { isConnection = true;  isComponent = false; }
	if (startsWith(lineContent, "<Node"))       { isConnection = false; isComponent = true;  }
	if (isConnection and startsWith(lineContent, "<Connection")) {
		string[] findId = find(lineContent, 'id="[^"]*"');
		if (length(findId) > 0) { connection = replace(replace(findId[0], "id=", ""), '"', ""); }
	}
	if (isComponent and startsWith(lineContent, "<Node ")) {
		string[] findId = find(lineContent, 'id="[^"]*"');
		if (length(findId) > 0) { component = replace(replace(findId[0], "id=", ""), '"', ""); }
	}
	string[] editedProperties;
	foreach (string property : $in.0.propertiesList) {
		string propertyREGEX = concat(property, '="[^"]*"');
		string[] matches = find(lineContent, propertyREGEX);
		for (integer i = 0; i < length(matches); i++) {
			string fullMatch = matches[i];
			integer eqQuote  = indexOf(fullMatch, '="');
			if (eqQuote < 0) { continue; }
			string attrValue = substring(fullMatch, eqQuote + 2, length(fullMatch) - eqQuote - 3);
			string redacted  = redactURLValue(attrValue, sensitiveParams);
			if (redacted != attrValue) {
				integer matchPos = indexOf(lineContent, fullMatch);
				if (matchPos >= 0) {
					lineContent = concat(
						left(lineContent, matchPos),
						property, '="', redacted, '"',
						right(lineContent, length(lineContent) - matchPos - length(fullMatch))
					);
				}
				if (!in(property, editedProperties)) { append(editedProperties, property); }
			}
		}
	}
	$out.0.lineContent = lineContent;
	$out.0.fileURL     = $in.0.fileURL;
	if (lineContent != originalLineContent) { dictionary.status = "REDACTED"; }
	$out.1.status    = dictionary.status;
	$out.1.sandbox   = getParamValue("SANDBOX_NAME");
	$out.1.file_url  = $in.0.fileURL;
	$out.1.file_name = getParamValue("FILE_NAME");
	if (length(editedProperties) > 0) {
		if (isConnection) { $out.1.type = "connection"; $out.1.name = connection; }
		else if (isComponent) { $out.1.type = "component"; $out.1.name = component; }
		$out.1.redacted_properties = join(",", editedProperties);
	}
	if ($out.1.status == "REDACTED") { $out.1.message = "Potentially sensitive data in URL"; }
	return ALL;
}
]]></attr>
</Node>
