<Node guiName="fileName" guiX="770" guiY="250" id="FILE_NAME" type="REFORMAT">
<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	$out.0.* = $in.0.*;
	string[] fileNames = split($in.0.fileURL,"/");
	
	$out.0.fileURL = fileNames[length(fileNames)-1];
	return ALL;
}

