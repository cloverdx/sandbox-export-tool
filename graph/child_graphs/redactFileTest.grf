<Node guiName="Check suspicious (potential misses)" guiX="1245" guiY="500" id="CHECK_SUSPICIOUS" type="REFORMAT">
<attr name="transform"><![CDATA[//#CTL2

// Checks an unchanged line for patterns that suggest it should have been redacted.
// Returns a human-readable reason string, or "" if the line looks clean.

function string checkSuspicious(string line) {
	string lc = lowerCase(line);
	string trimmed = trim(line);
	// Skip blank lines, comment lines, XML declarations, and CDATA markers
	if (trimmed == "") { return ""; }
	if (startsWith(trimmed, "#")) { return ""; }
	if (startsWith(trimmed, "//")) { return ""; }
	if (startsWith(trimmed, "<!--")) { return ""; }
	if (startsWith(trimmed, "<?xml")) { return ""; }
	if (startsWith(trimmed, "<![CDATA[")) { return ""; }
	// Skip lines that are pure XML structure with no URL-like content
	if (!contains(line, "://") and !contains(line, "=")) { return ""; }

	// ── Check 1: credentials in URL authority (scheme://user[:pass]@host) ──────
	if (contains(line, "://") and contains(line, "@")) {
		integer schemeEnd = indexOf(line, "://") + 3;
		integer atPos = indexOf(line, "@", schemeEnd);
		if (atPos > schemeEnd) {
			integer slashAfterScheme = indexOf(line, "/", schemeEnd);
			// @ must be before the first path slash (i.e. it is in the authority, not the path)
			if (slashAfterScheme < 0 or atPos < slashAfterScheme) {
				string authority = substring(line, schemeEnd, atPos - schemeEnd);
				if (!contains(authority, "${") and !contains(authority, "REDACTED")) {
					return concat("Credentials in URL authority: [", left(authority, 40), "]");
				}
			}
		}
	}

	// ── Check 2: sensitive query parameters still carrying a real value ─────────
	string[] params = ["password=", "api_key=", "apikey=", "secret=", "access_token=",
	                   "bearer_token=", "token=", "awssecretkey=", "accountkey=",
	                   "access_key=", "privatekey=", "sig=", "sas=", "client_secret="];
	for (integer i = 0; i < length(params); i++) {
		integer pos = indexOf(lc, params[i]);
		if (pos >= 0) {
			// Only suspicious if it appears after ? or & (i.e. it really is a query param)
			string before = left(line, pos);
			if (contains(before, "?") or contains(before, "&") or contains(before, "&amp;")) {
				integer valueStart = pos + length(params[i]);
				if (valueStart < length(line)) {
					string rest = right(line, length(line) - valueStart);
					// Grab value up to the next delimiter
					integer end = length(rest);
					integer amp  = indexOf(rest, "&"); if (amp  >= 0 and amp  < end) { end = amp;  }
					integer qut  = indexOf(rest, "\""); if (qut  >= 0 and qut  < end) { end = qut;  }
					integer apos = indexOf(rest, "'");  if (apos >= 0 and apos < end) { end = apos; }
					string val = left(rest, end);
					if (val != "" and !startsWith(lowerCase(val), "redacted") and !startsWith(val, "${")) {
						return concat("Sensitive query param not redacted: ", params[i], left(val, 30));
					}
				}
			}
		}
	}
	return "";
}

function integer transform() {
	$out.0.fileURL    = $in.0.fileURL;
	$out.0.sourceRow  = $in.0.sourceRow;
	$out.0.original   = $in.0.original;
	$out.0.reason     = checkSuspicious($in.0.original);
	return ALL;
}
]]></attr>
</Node>
<Node guiName="ExtHashJoin" guiX="970" guiY="325" id="EXT_HASH_JOIN" joinKey="$fileURL=$fileURL;$sourceRow=$sourceRow" type="EXT_HASH_JOIN">
<attr name="transform"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	$out.0.fileURL = $in.0.fileURL;
	$out.0.sourceRow = $in.0.sourceRow;
	$out.0.redacted = $in.0.lineContent;
	$out.0.original = $in.1.lineContent;

	return ALL;
}

