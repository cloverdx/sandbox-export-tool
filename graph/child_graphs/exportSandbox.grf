<Node guiName="Include large files?" guiX="320" guiY="500" id="FILTER" type="EXT_FILTER">
<attr name="filterExpression"><![CDATA[//#CTL2
$in.0.size <= str2long(getParamValue("FILE_SIZE_LIMIT_MB")) * 1048576]]></attr>
</Node>
<Node append="true" fileURL="${DATATMP_DIR}/TEMP_unexportedFiles.csv" guiName="FlatFileWriter" guiX="1645" guiY="825" id="FLAT_FILE_WRITER" type="FLAT_FILE_WRITER"/>
<Node guiName="ignore Directories" guiX="45" guiY="500" id="IGNORE_DIRECTORIES" type="EXT_FILTER">
<attr name="filterExpression"><![CDATA[//#CTL2
$in.0.isDirectory == false]]></attr>
</Node>
<Node guiName="Include all files?" guiX="920" guiY="625" id="INCLUDE_ALL_FILES" type="EXT_FILTER">
<attr name="filterExpression"><![CDATA[//#CTL2
getParamValue("ONLY_CLOVER_FILES") == "false"]]></attr>
</Node>
