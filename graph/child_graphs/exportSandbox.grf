<GraphParameters>
<GraphParameter name="SANDBOX_PATH" public="true" required="true"/>
<GraphParameter category="advanced" label="Number of executors" name="EXECUTORS_NUMBER" public="true" required="false" value="20">
<ComponentReference referencedComponent="SANITIZE_FILE1" referencedProperty="executorsNumber"/>
</GraphParameter>
<GraphParameter name="SANDBOX_NAME">
<attr name="dynamicValue"><![CDATA[//#CTL2

function string getValue() {
	string sandbox = getParamValue("SANDBOX_PATH");
	
	// Remove final "/"
	if (endsWith(sandbox,"/")) {sandbox = left(sandbox,(length(sandbox)-1));}
	
	//Isolate only the sandbox name from the path
	integer sandboxIndex = 1 + lastIndexOf(sandbox,"/");
	sandbox = right(sandbox,length(sandbox)-sandboxIndex);
	
	
	return sandbox;
}
]]></attr>
</GraphParameter>
<GraphParameterFile fileURL="workspace.prm"/>
<GraphParameter name="ONLY_CLOVER_FILES" public="true" value="true">
<attr name="description"><![CDATA[If "true" only clover files (.grf,.jbf,.etc.) will be exported.
Other files (.csv,.json, etc.) will be ignored.
If "false" all files in sandbox will be exported. ]]></attr>
<SingleType name="bool"/>
</GraphParameter>
<GraphParameter name="INCLUDE_LARGE_FILES" public="true" required="true" value="false">
<attr name="description"><![CDATA[ONLY FOR UNREDACTED MODE
Large files can take a long time to export
By default files over 1gb will not be exported.
If this parameter is "true" all files will be exported
regardless of size.]]></attr>
<SingleType name="bool"/>
</GraphParameter>
<GraphParameter name="FILE_SIZE_LIMIT_MB" value="100"/>
</GraphParameters>
<RichTextNote backgroundColor="FFB9B9" folded="false" fontSize="large" height="151" id="Note8" textColor="000000" width="877" x="50" y="175">
<attr name="text"><![CDATA[h1. This graph is meant to run as a child graph from RUN_ME.grf. It's not meant to run on it's own
]]></attr>
</RichTextNote>
<RichTextNote backgroundColor="9B59B6" folded="false" fontSize="medium" height="350" id="Note0" textColor="FFFFFF" width="726" x="500" y="425">
<attr name="text"><![CDATA[h3. Only Clover files or all files - determined by parameter ONLY_CLOVER_FILES]]></attr>
</RichTextNote>
<Dictionary/>
