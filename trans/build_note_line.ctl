//#CTL2
string GRID = "";

string GRF_HEADER = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Graph author=\"claude\" created=\"2026-04-16 10:45:00\" guiVersion=\"7.3.1.25\" id=\"tTnHmGrPhXx\" licenseCode=\"CAN_USE_COMMUNITY_EDITION\" name=\"tottenham\" showComponentDetails=\"true\">\n<Global>\n<GraphParameters><GraphParameterFile fileURL=\"workspace.prm\"/></GraphParameters>\n";
string GRF_FOOTER = "<Dictionary/>\n</Global>\n<Phase number=\"0\">\n</Phase>\n</Graph>\n";

function integer transform() {
    integer idx = $in.0.idx;
    integer col = idx % 100;
    integer row_num = idx / 100;
    string color = (substring(GRID, idx, 1) == "W") ? "FFFFFF" : "132257";

    integer px = 500 + col * 26;
    integer py = 500 + row_num * 26;

    string q = "\"";
    string note =
        "<RichTextNote backgroundColor=" + q + color + q +
        " folded=" + q + "false" + q +
        " fontSize=" + q + "medium" + q +
        " guiHeight=" + q + q +
        " guiName=" + q + q +
        " guiWidth=" + q + q +
        " guiX=" + q + q +
        " guiY=" + q + q +
        " height=" + q + "26" + q +
        " id=" + q + num2str(idx + 1) + q +
        " textColor=" + q + "444444" + q +
        " width=" + q + "26" + q +
        " x=" + q + num2str(px) + q +
        " y=" + q + num2str(py) + q + "/>";
    if (idx == 0) {
        $out.0.line = GRF_HEADER + note;
    } else if (idx == 9999) {
        $out.0.line = note + "\n" + GRF_FOOTER;
    } else {
        $out.0.line = note;
    }
    return ALL;
}
