<attr name="inputMapping"><![CDATA[//#CTL2

// Transforms input record into output record.
function integer transform() {
	$out.1.INCLUDE = $in.0.INCLUDE;
	$out.1.EXCLUDE = $in.0.EXCLUDE;
	$out.1.EXPORT_MODE = $in.0.EXPORT_MODE;
	$out.1.TIMESTAMP = getParamValue("TIMESTAMP");

	return ALL;
}

