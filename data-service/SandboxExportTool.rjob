<Global>
<EndpointSettings>
<UrlPath>/SandboxExportTool</UrlPath>
<Description>Tool for bulk exporting of sandboxes, with option for redacting sensitive data.</Description>
<Category>Sandbox Export Tool</Category>
<IconUrl>data-service/icon/sandbox.png</IconUrl>
<RequestMethod name="POST"/>
<RequestParameter description="Run ONLY these sandboxes (comma delimited list)" id="RestJobParameter0" location="form_data" name="INCLUDE" required="false" type="string"/>
