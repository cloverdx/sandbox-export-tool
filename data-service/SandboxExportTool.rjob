<RequestParameter id="RestJobParameter2" location="form_data" name="EXPORT_MODE" required="true" type="enumeration">
<Options allowCustomValues="false">
<Option label="Redacted Mode" value="redacted"/>
<Option label="Unredacted Mode with only Clover files" value="unredacted_clover_files"/>
<Option label="Unredacted Mode with all files under 100MB" value="unredacted_no_large_files"/>
<Option label="Unredacted Mode with all files" value="unredacted_large_files"/>
</Options>
</RequestParameter>
